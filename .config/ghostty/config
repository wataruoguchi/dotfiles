# Theme (matches WezTerm's "Tokyo Night")
theme = TokyoNight

# Font (matches WezTerm)
font-family = MesloLGS Nerd Font Mono
font-size = 15

# Transparency + blur (matches WezTerm)
background-opacity = 0.8
background-blur = 10

# Titlebar
macos-titlebar-style = transparent

# Tabs
window-show-tab-bar = auto

# ---------------------------------------------------------------------------
# tmux-style keybindings (leader = ctrl+b)
#
# The leader is ctrl+b, not ctrl+a, so it stays out of the way of Herdr's
# ctrl+a prefix (.config/herdr/config.toml) when Herdr runs inside Ghostty.
# .config/wezterm/tmux.lua still uses ctrl+a.
#
# Ghostty has no leader-with-timeout; it uses key sequences (`a>b`) that wait
# indefinitely for the next key. Press ctrl+b twice to send a literal ctrl+b.
# ---------------------------------------------------------------------------

keybind = ctrl+b>ctrl+b=text:\x02

# Splitting
# ctrl+b " -> split top/bottom, ctrl+b % -> split left/right.
# Shifted punctuation is bound by physical key (`shift+quote`) because Ghostty
# matches the *unshifted* codepoint plus modifiers; the codepoint forms are
# kept alongside for non-US layouts.
keybind = ctrl+b>shift+quote=new_split:down
keybind = ctrl+b>"=new_split:down
keybind = ctrl+b>shift+digit_5=new_split:right
keybind = ctrl+b>%=new_split:right

# Navigation (vim keys)
keybind = ctrl+b>h=goto_split:left
keybind = ctrl+b>j=goto_split:down
keybind = ctrl+b>k=goto_split:up
keybind = ctrl+b>l=goto_split:right

# Navigation (arrow keys)
keybind = ctrl+b>arrow_left=goto_split:left
keybind = ctrl+b>arrow_down=goto_split:down
keybind = ctrl+b>arrow_up=goto_split:up
keybind = ctrl+b>arrow_right=goto_split:right

# Cycle splits in creation order
keybind = ctrl+b>o=goto_split:next
keybind = ctrl+b>shift+o=goto_split:previous

# Resize the active split (amount is in pixels, not cells)
keybind = ctrl+b>shift+h=resize_split:left,20
keybind = ctrl+b>shift+j=resize_split:down,20
keybind = ctrl+b>shift+k=resize_split:up,20
keybind = ctrl+b>shift+l=resize_split:right,20

# Repeatable resize without re-pressing the leader (Ghostty defaults, kept
# explicit so they stay next to the bindings above)
keybind = super+ctrl+arrow_left=resize_split:left,20
keybind = super+ctrl+arrow_down=resize_split:down,20
keybind = super+ctrl+arrow_up=resize_split:up,20
keybind = super+ctrl+arrow_right=resize_split:right,20

# Layout
keybind = ctrl+b>equal=equalize_splits
keybind = ctrl+b>z=toggle_split_zoom
keybind = ctrl+b>x=close_surface

# Tabs (tmux window equivalents)
keybind = ctrl+b>c=new_tab
keybind = ctrl+b>n=next_tab
keybind = ctrl+b>p=previous_tab

# Scrollback search (tmux prefix + /)
keybind = ctrl+b>slash=start_search
keybind = ctrl+b>[=scroll_page_up
keybind = ctrl+b>]=scroll_page_down

# Reload this config (tmux prefix + r). super+shift+, is Ghostty's default and
# still works; it's the one to use if a bad edit breaks the leader bindings.
keybind = ctrl+b>r=reload_config
